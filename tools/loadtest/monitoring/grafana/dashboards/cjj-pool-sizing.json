{
 "uid": "cjj-pool-sizing",
 "title": "cjj 풀 크기 실험 — Queue-ms · Run-ms · 대기 이벤트",
 "tags": [
  "loadtest",
  "pool-sizing"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "annotations": {
  "list": [
   {
    "name": "시험 구간",
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "iconColor": "rgba(255, 96, 96, 1)",
    "target": {
     "type": "tags",
     "tags": [
      "pool-sweep"
     ],
     "limit": 100,
     "matchAny": true
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "처리량 — 포장 완료 성공/초 (서버)",
   "description": "영상의 TPS에 해당",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_requests_seconds_count{uri='/api/v1/shipments/{shipmentId}/complete',status=~'2..'}[15s]))",
     "legendFormat": "완료/s"
    },
    {
     "refId": "B",
     "expr": "sum(rate(http_server_requests_seconds_count{uri='/api/v1/shipments/{shipmentId}/complete',status=~'5..'}[15s]))",
     "legendFormat": "완료 5xx/s"
    }
   ],
   "interval": "5s"
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Queue-ms — 커넥션 획득 시간 p95/p99/max",
   "description": "HikariCP 풀에서 커넥션을 받기까지 기다린 시간. 영상의 Queue-ms",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(hikaricp_connections_acquire_seconds_bucket[15s]))) * 1000",
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(hikaricp_connections_acquire_seconds_bucket[15s]))) * 1000",
     "legendFormat": "p99"
    },
    {
     "refId": "C",
     "expr": "max(hikaricp_connections_acquire_seconds_max) * 1000",
     "legendFormat": "max"
    }
   ],
   "interval": "5s"
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Run-ms — 커넥션 점유 시간 p95/p99/max",
   "description": "커넥션을 받은 뒤 반납할 때까지. 영상의 Run-ms",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(hikaricp_connections_usage_seconds_bucket[15s]))) * 1000",
     "legendFormat": "p95"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(hikaricp_connections_usage_seconds_bucket[15s]))) * 1000",
     "legendFormat": "p99"
    },
    {
     "refId": "C",
     "expr": "max(hikaricp_connections_usage_seconds_max) * 1000",
     "legendFormat": "max"
    }
   ],
   "interval": "5s"
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "서버 응답 p95 — 완료·스캔·상세",
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{uri=~'/api/v1/shipments/{shipmentId}/complete|/api/v1/totes/scan|/api/v1/shipments/{shipmentId}'}[15s]))) * 1000",
     "legendFormat": "{{uri}}"
    }
   ],
   "interval": "5s"
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "HikariCP — active / pending / max",
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(hikaricp_connections_active)",
     "legendFormat": "active"
    },
    {
     "refId": "B",
     "expr": "sum(hikaricp_connections_pending)",
     "legendFormat": "pending"
    },
    {
     "refId": "C",
     "expr": "sum(hikaricp_connections_max)",
     "legendFormat": "max"
    }
   ],
   "interval": "5s"
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Tomcat 스레드 — busy / max",
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(tomcat_threads_busy_threads)",
     "legendFormat": "busy"
    },
    {
     "refId": "B",
     "expr": "sum(tomcat_threads_config_max_threads)",
     "legendFormat": "max"
    }
   ],
   "interval": "5s"
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "RDS 앱 세션 — 상태·대기 이벤트별 (5초 표본)",
   "description": "대기 이벤트가 비어 있는 active 는 CPU 에서 일하는 세션. 영상의 Top Wait Event",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (wait_event_type, wait_event) (pg_stat_activity_count{datname='app',application_name='PostgreSQL JDBC Driver',state='active'})",
     "legendFormat": "active {{wait_event_type}}:{{wait_event}}"
    },
    {
     "refId": "B",
     "expr": "sum(pg_stat_activity_count{datname='app',application_name='PostgreSQL JDBC Driver',state='idle in transaction'})",
     "legendFormat": "idle in tx"
    }
   ],
   "interval": "5s"
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "CPU — EC2 · RDS 커밋/초",
   "description": "",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "spanNulls": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "RDS commit/s"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - avg(rate(node_cpu_seconds_total{mode='idle'}[15s]))",
     "legendFormat": "EC2 CPU"
    },
    {
     "refId": "B",
     "expr": "sum(rate(pg_stat_database_xact_commit{datname='app'}[15s]))",
     "legendFormat": "RDS commit/s"
    }
   ],
   "interval": "5s"
  }
 ]
}