# pool-sweep.sh 조작판. 사용자가 바꾸는 값은 전부 여기에 있다. 명령줄에서 같은 이름으로 덮어쓸 수 있다.
#   POOL_SIZES="5 10" LOADS="sat:200:0:0:200" bash tools/loadtest/pool-sweep.sh sweep
# 자격증명(SSH 키, Grafana 비밀번호, 데모 키)은 이 파일에 넣지 않는다. 키는 경로만, 나머지는 local/ 과 백엔드 .env 에서 읽는다.

# ── 실험 변수 ─────────────────────────────────────────────────────────────
# 조건 = POOL_SIZES × CONN_TIMEOUTS_MS × TOMCAT_THREADS × LOADS × REPEAT. 순서대로 돈다.
POOL_SIZES="${POOL_SIZES:-2 5 10 20 40}"          # HikariCP maximumPoolSize (RDS max_connections 79 아래)
CONN_TIMEOUTS_MS="${CONN_TIMEOUTS_MS:-30000}"    # HikariCP connectionTimeout. 기본값 30000
TOMCAT_THREADS="${TOMCAT_THREADS:-200}"          # server.tomcat.threads.max. 기본값 200
# 부하 수준. 공백으로 구분한 "이름:작업자수(VU):사이클ms(PACING):포장작업ms(THINK):완료후대기ms" 목록.
#   사이클 60000 = 작업자 1명이 1분에 1건 포장. THINK 는 상세 조회와 완료 사이, 실제로 상자를 싸는 시간.
#   peak1x·peak3x 근거는 docs/evidence/pool-sizing/PLAN.md 1절(비즈니스 트래픽 산정).
LOADS="${LOADS:-peak1x:100:60000:50000:0 peak3x:300:60000:50000:0 sat:100:0:0:0}"
REPEAT="${REPEAT:-1}"                            # 같은 조건 반복 횟수(재현성). REP_START 로 반복 번호 시작값
SWEEP_DIR="${SWEEP_DIR:-}"                       # 비우면 새 디렉터리. 주면 그 디렉터리에 이어 붙임
WARMUP_S="${WARMUP_S:-30}"                       # 판독에서 빼는 시작 구간
MEASURE_S="${MEASURE_S:-240}"                    # 판독 구간 길이. k6 는 WARMUP_S+MEASURE_S 동안 돈다
SCENARIO="${SCENARIO:-packing}"                  # packing | orders_import
CLIENT_TIMEOUT="${CLIENT_TIMEOUT:-60s}"          # k6 요청 타임아웃(작업자 화면이 기다리는 한도). 기존 run.sh 는 10s
# 락 주입: "시작초:유지초". 비우면 안 한다. 판독 구간 시작 기준 N초 뒤 psql 세션이 박스 행 전부를
# SELECT ... FOR UPDATE 로 잡고 유지초 동안 놓지 않는다(docs/evidence/loadtest/ledger-review-repro.md 방식).
LOCK_INJECT="${LOCK_INJECT:-}"
CAPTURE="${CAPTURE:-1}"                          # 1 이면 조건마다 Grafana 대시보드 PNG 를 찍는다(python playwright)
SETTLE_S="${SETTLE_S:-10}"                       # 재시작·데이터 원복 뒤 k6 시작 전 대기

# ── 대상 환경 ─────────────────────────────────────────────────────────────
BACKEND_HOST="${BACKEND_HOST:-13.124.19.3}"          # 백엔드 EC2 공인 IP (SSH·Prometheus·Grafana)
BACKEND_PRIVATE="${BACKEND_PRIVATE:-172.31.64.6}"    # 부하 발생기가 보는 백엔드 주소(같은 VPC)
LOADGEN_HOST="${LOADGEN_HOST:-43.203.152.223}"       # k6 부하 발생기 EC2
SSH_USER="${SSH_USER:-ubuntu}"
SSH_KEY="${SSH_KEY:-$HOME/cjj/key.pem}"
KNOWN_HOSTS="${KNOWN_HOSTS:-$REPO_ROOT/local/known_hosts}"   # 호스트 키를 고정한 파일(gitignore)
BACKEND_DIR="${BACKEND_DIR:-/home/ubuntu/backend}"           # compose 프로젝트 경로. .env 에 DB·데모 키
BACKEND_CONTAINER="${BACKEND_CONTAINER:-backend-backend-1}"
PSQL_IMAGE="${PSQL_IMAGE:-postgres:18}"              # 백엔드 호스트에서 RDS 에 붙는 psql 컨테이너
PROM_PUBLIC="${PROM_PUBLIC:-http://$BACKEND_HOST:9090}"
GRAFANA_PUBLIC="${GRAFANA_PUBLIC:-http://$BACKEND_HOST:3000}"
GRAFANA_ENV="${GRAFANA_ENV:-$REPO_ROOT/local/grafana.env}"   # GRAFANA_ADMIN_PASSWORD (주석 기록용)
RDS_ID="${RDS_ID:-cjj-postgres}"                     # CloudWatch CPU 조회(boto3, 로컬 AWS 자격증명)
AWS_REGION="${AWS_REGION:-ap-northeast-2}"

# ── 데이터 ────────────────────────────────────────────────────────────────
# 풀 크기 실험 전용 배송단위 묶음. 주문번호 접두사로 구분하고, 조건마다 포장 전 상태로 되돌린다.
FIXTURE_PREFIX="${FIXTURE_PREFIX:-PSFIX-}"
FIXTURE_BOX_STOCK="${FIXTURE_BOX_STOCK:-50000}"      # 원복 때 박스 재고를 이 값으로 맞춘다
# 조건마다 이 id 보다 큰 실험 원장 행을 지우고 스냅샷을 다시 만든다(sweep/ledger-reset.sql). 비우면 원장을 두고 간다.
# 21674 = 2026-09-25 실험 시작 전 원장의 마지막 id. 원장 원복 뒤에는 집계기·대조기가 한 바퀴 돌도록 SETTLE_S 를 90 으로.
LEDGER_CUTOFF_ID="${LEDGER_CUTOFF_ID:-3131672}"  # 09-26 22:3x 새 기준선(원장 29행). 이전 21674 는 데모 리셋 사고로 무효
# RDS CPU 크레딧이 이 호출 시작(또는 CREDIT_BASE) 대비 이 비율 아래로 떨어지면 다음 조건을 시작하지 않고 멈춘다.
CREDIT_BASE="${CREDIT_BASE:-}"
CREDIT_STOP_RATIO="${CREDIT_STOP_RATIO:-0.5}"
OUT_ROOT="${OUT_ROOT:-$REPO_ROOT/docs/evidence/pool-sizing}"
